# Copy to .env and fill in. Any OpenAI-compatible endpoint that serves Olala 1.0 mini works:
# llama-server from the OVHai-LLM llama.cpp fork (default below), the OVHai-LLM vLLM fork, or mlx-engine on a Mac.
# Upstream LM Studio and Ollama cannot load Olala yet. Commands: https://huggingface.co/OVHaiLLM/Olala-v1.0-mini-7A1B
OLALA_BASE_URL=http://127.0.0.1:8080/v1
OLALA_API_KEY=
OLALA_MODEL=olala
